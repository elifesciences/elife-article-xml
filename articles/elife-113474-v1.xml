<?xml version="1.0" encoding="UTF-8"?><!DOCTYPE article PUBLIC "-//NLM//DTD JATS (Z39.96) Journal Archiving and Interchange DTD v1.4 20241031//EN"  "JATS-archivearticle1-4-mathml3.dtd"><article xmlns:ali="http://www.niso.org/schemas/ali/1.0/" xmlns:mml="http://www.w3.org/1998/Math/MathML" xmlns:xlink="http://www.w3.org/1999/xlink" article-type="correction" dtd-version="1.4"><front><journal-meta><journal-id journal-id-type="nlm-ta">elife</journal-id><journal-id journal-id-type="publisher-id">eLife</journal-id><journal-title-group><journal-title>eLife</journal-title></journal-title-group><issn publication-format="electronic" pub-type="epub">2050-084X</issn><publisher><publisher-name>eLife Sciences Publications, Ltd</publisher-name></publisher></journal-meta><article-meta><article-id pub-id-type="publisher-id">113474</article-id><article-id pub-id-type="doi">10.7554/eLife.113474</article-id><article-version article-version-type="publication-state">version of record</article-version><article-categories><subj-group subj-group-type="display-channel"><subject>Correction</subject></subj-group><subj-group subj-group-type="heading"><subject>Biochemistry and Chemical Biology</subject></subj-group></article-categories><title-group><article-title>Correction: Stall force measurement of the kinesin-3 motor KIF1A using a programmable DNA origami nanospring</article-title></title-group><contrib-group><contrib contrib-type="author"><name><surname>Takamatsu</surname><given-names>Nobumichi</given-names></name></contrib><contrib contrib-type="author"><name><surname>Furumoto</surname><given-names>Hiroko</given-names></name></contrib><contrib contrib-type="author"><name><surname>Ariga</surname><given-names>Takayuki</given-names></name><contrib-id authenticated="true" contrib-id-type="orcid">https://orcid.org/0000-0002-2045-5761</contrib-id></contrib><contrib contrib-type="author" corresp="yes"><name><surname>Iwaki</surname><given-names>Mitsuhiro</given-names></name><email>iwakim@nict.go.jp</email></contrib><contrib contrib-type="author" corresp="yes"><name><surname>Hayashi</surname><given-names>Kumiko</given-names></name><contrib-id authenticated="true" contrib-id-type="orcid">https://orcid.org/0000-0002-2895-8945</contrib-id><email>hayashi@issp.u-tokyo.ac.jp</email></contrib></contrib-group><pub-date publication-format="electronic" date-type="publication"><day>21</day><month>10</month><year>2026</year></pub-date><volume>15</volume><elocation-id>e113474</elocation-id><permissions><copyright-statement>© 2026, Takamatsu et al</copyright-statement><copyright-year>2026</copyright-year><copyright-holder>Takamatsu et al</copyright-holder><ali:free_to_read/><license xlink:href="http://creativecommons.org/licenses/by/4.0/"><ali:license_ref>http://creativecommons.org/licenses/by/4.0/</ali:license_ref><license-p>This article is distributed under the terms of the <ext-link ext-link-type="uri" xlink:href="http://creativecommons.org/licenses/by/4.0/">Creative Commons Attribution License</ext-link>, which permits unrestricted use and redistribution provided that the original author and source are credited.</license-p></license></permissions><related-article related-article-type="corrected-article" ext-link-type="doi" xlink:href="10.7554/eLife.108477" id="ra1"/><kwd-group kwd-group-type="research-organism"><title>Research organism</title><kwd>Human</kwd></kwd-group></article-meta></front><body><boxed-text><p> Takamatsu N, Furumoto H, Ariga T, Iwaki M, Hayashi K. 2026. Stall force measurement of the kinesin-3 motor KIF1A using a programmable DNA origami nanospring. <italic>eLife</italic> <bold>14</bold>:RP108477. doi: <ext-link ext-link-type="uri" xlink:href="http://doi.org/10.7554/eLife.108477">10.7554/eLife.108477</ext-link>.</p><p>Published 25 March 2026</p></boxed-text><p>After publication, we became aware of three errors in the Materials and methods section: one in the description of the buffer composition and two in the description of the analytical methods. These errors arose from oversights during manuscript preparation. Because the experiments and analyses were conducted correctly, these corrections do not affect the figures, data, statistical analyses, results, interpretation, or conclusions of the article.</p><p>1. Materials and methods, “Kinesin-NS conjugation”:</p><p>The SRP90 buffer composition was incomplete, with 10% glycerol inadvertently omitted from the manuscript.</p><p>Corrected text:</p><p>“SRP90 buffer (90 mM HEPES, 50 mM CH<sub>3</sub>COOK, 2 mM Mg(CH<sub>3</sub>COO)<sub>2</sub>, 1 mM EGTA, 10% glycerol, pH 7.6, adjusted with KOH)”</p><p>Original text:</p><p>“SRP90 buffer (90 mM HEPES, 50 mM CH<sub>3</sub>COOK, 2 mM Mg(CH<sub>3</sub>COO)<sub>2</sub>, 1 mM EGTA, pH 7.6, adjusted with KOH)”</p><p>2. Materials and methods, “Angular fluctuation”:</p><p>The number of frames used to calculate the mean direction vector (<inline-formula><alternatives><mml:math id="inf1"><mml:mover accent="true"><mml:mrow><mml:msub><mml:mrow><mml:mi>R</mml:mi></mml:mrow><mml:mrow><mml:mi>t</mml:mi></mml:mrow></mml:msub></mml:mrow><mml:mo>→</mml:mo></mml:mover></mml:math><tex-math id="inft1">\begin{document}$\overset{\rightarrow }{R_{t}}$\end{document}</tex-math></alternatives></inline-formula>) were incorrectly described.</p><p>Corrected text:<disp-formula id="equ1"><alternatives><mml:math id="m1"><mml:mstyle displaystyle="true" scriptlevel="0"><mml:mrow><mml:mstyle displaystyle="true" scriptlevel="0"><mml:mstyle displaystyle="true" scriptlevel="0"><mml:mover><mml:msub><mml:mi>R</mml:mi><mml:mrow><mml:mi>t</mml:mi></mml:mrow></mml:msub><mml:mo stretchy="false">→</mml:mo></mml:mover><mml:mo>=</mml:mo><mml:mfrac><mml:mn>1</mml:mn><mml:mn>11</mml:mn></mml:mfrac><mml:munderover><mml:mo>∑</mml:mo><mml:mrow><mml:mi>j</mml:mi><mml:mo>=</mml:mo><mml:mi>t</mml:mi><mml:mo>−</mml:mo><mml:mn>5</mml:mn></mml:mrow><mml:mrow><mml:mi>t</mml:mi><mml:mo>+</mml:mo><mml:mn>5</mml:mn></mml:mrow></mml:munderover><mml:mover><mml:msub><mml:mi>v</mml:mi><mml:mrow><mml:mi>j</mml:mi></mml:mrow></mml:msub><mml:mo stretchy="false">→</mml:mo></mml:mover><mml:mo>.</mml:mo></mml:mstyle></mml:mstyle></mml:mrow></mml:mstyle></mml:math><tex-math id="t1">\begin{document}$$\displaystyle  \overset{\rightarrow }{R_{t}}=\frac{1}{11}\sum _{j=t-5}^{t+5}\overset{\rightarrow }{v_{j}}.$$\end{document}</tex-math></alternatives></disp-formula></p><p>Original text:<disp-formula id="equ2"><alternatives><mml:math id="m2"><mml:mstyle displaystyle="true" scriptlevel="0"><mml:mrow><mml:mstyle displaystyle="true" scriptlevel="0"><mml:mstyle displaystyle="true" scriptlevel="0"><mml:mover><mml:msub><mml:mi>R</mml:mi><mml:mrow><mml:mi>t</mml:mi></mml:mrow></mml:msub><mml:mo stretchy="false">→</mml:mo></mml:mover><mml:mo>=</mml:mo><mml:mfrac><mml:mn>1</mml:mn><mml:mi>ω</mml:mi></mml:mfrac><mml:munderover><mml:mo>∑</mml:mo><mml:mrow><mml:mi>j</mml:mi><mml:mo>=</mml:mo><mml:mi>t</mml:mi><mml:mo>−</mml:mo><mml:mi>ω</mml:mi><mml:mrow><mml:mo>/</mml:mo></mml:mrow><mml:mn>2</mml:mn></mml:mrow><mml:mrow><mml:mi>t</mml:mi><mml:mo>+</mml:mo><mml:mi>ω</mml:mi><mml:mrow><mml:mo>/</mml:mo></mml:mrow><mml:mn>2</mml:mn><mml:mo>+</mml:mo><mml:mn>1</mml:mn></mml:mrow></mml:munderover><mml:mover><mml:msub><mml:mi>v</mml:mi><mml:mrow><mml:mi>t</mml:mi></mml:mrow></mml:msub><mml:mo stretchy="false">→</mml:mo></mml:mover><mml:mo>.</mml:mo></mml:mstyle></mml:mstyle></mml:mrow></mml:mstyle></mml:math><tex-math id="t2">\begin{document}$$\displaystyle  \overset{\rightarrow }{R_{t}}=\frac{1}{\omega }\sum _{j=t-\omega /2}^{t+\omega /2+1}\overset{\rightarrow }{v_{t}}.$$\end{document}</tex-math></alternatives></disp-formula></p><p>3. Materials and methods, “Rate of relative increase in NS’s length”:</p><p>The equation describing the 10-frame moving average of the NS extension (<inline-formula><alternatives><mml:math id="inf2"><mml:mstyle><mml:mrow><mml:mstyle displaystyle="false"><mml:mover><mml:mi>L</mml:mi><mml:mo accent="false">¯</mml:mo></mml:mover><mml:mrow><mml:mo>(</mml:mo><mml:mi>τ</mml:mi><mml:mo>)</mml:mo></mml:mrow></mml:mstyle></mml:mrow></mml:mstyle></mml:math><tex-math id="inft2">\begin{document}$\overline{L}\left (\tau \right)$\end{document}</tex-math></alternatives></inline-formula>) was incorrectly written.</p><p>Corrected text:</p><p>“<inline-formula><alternatives><mml:math id="inf3"><mml:mstyle><mml:mrow><mml:mstyle displaystyle="false"><mml:mover><mml:mi>L</mml:mi><mml:mo accent="false">¯</mml:mo></mml:mover><mml:mrow><mml:mo>(</mml:mo><mml:mi>τ</mml:mi><mml:mo>)</mml:mo></mml:mrow><mml:mrow><mml:mo>(</mml:mo><mml:mrow><mml:mo>=</mml:mo><mml:mrow><mml:mo>(</mml:mo><mml:mrow><mml:munderover><mml:mo>∑</mml:mo><mml:mrow><mml:mi>t</mml:mi><mml:mo>=</mml:mo><mml:mi>τ</mml:mi><mml:mo>−</mml:mo><mml:mn>5</mml:mn></mml:mrow><mml:mrow><mml:mi>τ</mml:mi><mml:mo>+</mml:mo><mml:mn>4</mml:mn></mml:mrow></mml:munderover><mml:mi>L</mml:mi><mml:mrow><mml:mo>(</mml:mo><mml:mi>t</mml:mi><mml:mo>)</mml:mo></mml:mrow></mml:mrow><mml:mo>)</mml:mo></mml:mrow><mml:mrow><mml:mo fence="true" stretchy="true" symmetric="true" maxsize="1.2em" minsize="1.2em">/</mml:mo></mml:mrow><mml:mn>10</mml:mn></mml:mrow><mml:mo>)</mml:mo></mml:mrow></mml:mstyle></mml:mrow></mml:mstyle></mml:math><tex-math id="inft3">\begin{document}$\overline{L}\left (\tau \right)\left (=\left (\sum _{t=\tau -5}^{\tau +4}L\left (t\right)\right)\big/10\right)$\end{document}</tex-math></alternatives></inline-formula> where <inline-formula><alternatives><mml:math id="inf4"><mml:mi>τ</mml:mi></mml:math><tex-math id="inft4">\begin{document}$\tau $\end{document}</tex-math></alternatives></inline-formula> represents a video frame”</p><p>Original text:</p><p>“<inline-formula><alternatives><mml:math id="inf5"><mml:mstyle><mml:mrow><mml:mstyle displaystyle="false"><mml:mover><mml:mi>L</mml:mi><mml:mo accent="false">¯</mml:mo></mml:mover><mml:mrow><mml:mo>(</mml:mo><mml:mi>τ</mml:mi><mml:mo>)</mml:mo></mml:mrow><mml:mrow><mml:mo>(</mml:mo><mml:mrow><mml:mo>=</mml:mo><mml:mrow><mml:mo>(</mml:mo><mml:mrow><mml:munderover><mml:mo>∑</mml:mo><mml:mrow><mml:mi>t</mml:mi><mml:mo>=</mml:mo><mml:mn>10</mml:mn><mml:mrow><mml:mo>(</mml:mo><mml:mrow><mml:mi>τ</mml:mi><mml:mo>−</mml:mo><mml:mn>1</mml:mn></mml:mrow><mml:mo>)</mml:mo></mml:mrow><mml:mo>+</mml:mo><mml:mn>1</mml:mn></mml:mrow><mml:mrow><mml:mn>10</mml:mn><mml:mi>τ</mml:mi></mml:mrow></mml:munderover><mml:mi>L</mml:mi><mml:mrow><mml:mo>(</mml:mo><mml:mi>t</mml:mi><mml:mo>)</mml:mo></mml:mrow></mml:mrow><mml:mo>)</mml:mo></mml:mrow><mml:mrow><mml:mo fence="true" stretchy="true" symmetric="true" maxsize="1.2em" minsize="1.2em">/</mml:mo></mml:mrow><mml:mn>10</mml:mn></mml:mrow><mml:mo>)</mml:mo></mml:mrow></mml:mstyle></mml:mrow></mml:mstyle></mml:math><tex-math id="inft5">\begin{document}$\overline{L}\left (\tau \right)\left (=\left (\sum _{t=10\left (\tau -1\right)+1}^{10\tau}L\left (t\right)\right)\big/10\right)$\end{document}</tex-math></alternatives></inline-formula> where <inline-formula><alternatives><mml:math id="inf6"><mml:mi>t</mml:mi></mml:math><tex-math id="inft6">\begin{document}$t$\end{document}</tex-math></alternatives></inline-formula> represents a video frame”</p><p>The article has been corrected accordingly.</p></body></article>